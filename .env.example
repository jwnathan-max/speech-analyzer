# Anthropic API (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API (Whisper STT)
OPENAI_API_KEY=sk-...

# Notion Integration Token
NOTION_TOKEN=secret_...

# Notion DB IDs (URL에서 복사: notion.so/{workspace}/{DB_ID}?v=...)
NOTION_TALKS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_SCRIPTURES_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Talks DB 속성명 (실제 DB 속성명과 정확히 일치해야 함)
NOTION_TALKS_TITLE_PROP=Name
NOTION_TALKS_SPEAKER_PROP=Speaker
NOTION_TALKS_DATE_PROP=Date
NOTION_TALKS_SCORE_PROP=OutlineScore
NOTION_TALKS_SOURCE_PROP=Source
NOTION_TALKS_SCRIPTURE_PROP=Scriptures

# Notion Scriptures DB 속성명
NOTION_SCRIPTURES_TITLE_PROP=Name
